  "sections": [
    {
      "section_id": "kohler-volume-3:p0175-p0180:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                                                      Indigofera                        Anil            L.\n          Sichelfrüchtiger Indigo, Anilindigo, Anilpflanze, Anil mal. Tarum                                                         Kembang.\n\n       Familie: Paprikonacese                         Endl.         Gruppe:             Lotoidene       Endl.        Unterfamilie:               @enisteae.\nGattung: Indigofera L.",
      "normalized_text": null,
      "zh_tw_rendering": "學名 Indigofera Anil L.，隸屬豆科，別名 Anil 或 Tarum Kembang。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 175,
        "source_pdf_sha256": "e5595cebe80e6e645852e6ee581189f0b179d54d74ef72d0e5c10456a110ed64",
        "char_start": 0,
        "char_end": 427,
        "page_text_sha256": "b40cc068030caa1bfcaa6b57ffc7098855f49e3a9a5cfe8438f81b188e841a90",
        "exact_text_sha256": "2efafe9432d8993b65492149e513d8378798809bd67d9f7640ef7be9732ada48",
        "source_line_start": 1,
        "source_line_end": 5,
        "section_index": 0,
