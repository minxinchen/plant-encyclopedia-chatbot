  "sections": [
    {
      "section_id": "kohler-volume-3:p0343-p0346:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                                                  Carex             arenaria                 L.\n Sandriedgras,            Sandsegge, rote Quecke.                    Engl.: Sea sedge.                 Franz.: Chiendent                  rouge.\n\n           Syn.: Vignea arenaria Reichenbach.\n\n           Familie: Oyperaceae.               Unterfamilie: Cariceae                Gattung: (arex L. Sekt.: Homostachyae.",
      "normalized_text": null,
      "zh_tw_rendering": "學名 Carex arenaria L.，同義名 Vignea arenaria。屬禾本科，Carex 屬，Homostachyae 組。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
