    {
      "section_id": "kohler-volume-3:p0299-p0302:s03:x00",
      "section_type": "distribution",
      "original_text": "       Vorkommen und Kultur. Die Pflanze wächst in den Mittelmeerländern, den Kanarischen\nInseln und im Orient wild: in Deutschland ist sie eine überaus häufige Zierde der Bauern-\ngärten,       und     findet     sich     deshalb     verwildert        und     bisweilen       als    Gartenflüchtling          vor.      In",
      "normalized_text": null,
      "zh_tw_rendering": "野生於地中海、加那利群島及東方；德國農園常見，亦作逸生植物。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 300,
        "source_pdf_sha256": "e5595cebe80e6e645852e6ee581189f0b179d54d74ef72d0e5c10456a110ed64",
