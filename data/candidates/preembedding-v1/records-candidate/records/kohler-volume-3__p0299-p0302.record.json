      "section_id": "kohler-volume-3:p0299-p0302:s00:x00",
      "section_type": "taxonomy",
      "original_text": "            Familie: Compositae Adans.                           Sekt.: Cynareae Juss.               Trib.: Calenduloideae Less.                 Unter-\nfamilie: Calenduleae Less.                     Gattung:                Calendula L.",
      "normalized_text": null,
      "zh_tw_rendering": "菊科，Cynareae族，Calenduloideae亞科，Calenduleae族，Calendula屬。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
