      "section_type": "flowering",
      "original_text": "            Blütezeit.         Juni bis August.",
      "normalized_text": null,
      "zh_tw_rendering": "花期為六月至八月。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
