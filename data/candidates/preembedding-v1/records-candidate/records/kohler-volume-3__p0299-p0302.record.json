    {
      "section_id": "kohler-volume-3:p0299-p0302:s04:x00",
      "section_type": "constituents",
      "original_text": "           Bestandteile.         Die Ringelblumen enthalten etwas ätherisches Öl, Bitterstoff, Calendulin,\nApfelsäure       und    ihre Salze, Asche.           Das Calendulin,              dessen     chemische Natur           noch    wenig   be-\nkannt     ist, erhält man        aus    dem    Extrakt      der Blätter        und      Blüten    der Pflanze        durch     Behandeln\ndesselben        mit Wasser       und    Äther;      es    bildet       eine gelbliche       durchsichtige      zerreibliche        Masse\nohne Geruch,           Geschmack         und Reaktion,",
      "normalized_text": null,
      "zh_tw_rendering": "含揮發油、苦味質、金盞花素、蘋果酸及其鹽類、灰分。",
      "evidence_indexes": [
        2
      ],
      "source_locator": {
