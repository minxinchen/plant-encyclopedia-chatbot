  "sections": [
    {
      "section_id": "kohler-volume-3:p0185-p0188:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                             Chaerophyllum                             bulbosum                L.\n                       Knolliger          Kälberkropf,         Kerbelrübe,             Erdkastanie.\n\n           Syn.    Scandix    bulbosa     Roth,   Myrrhis    bulbosa   Sprengel.\n\n         Familie: Umbelliferae Jussieu. Abteilung:                        Campylospermae Jussieu.        Unterfamilie:\nScandicineae Koch. Gattung: Ühaerophylium L.",
      "normalized_text": null,
      "zh_tw_rendering": "學名 Chaerophyllum bulbosum L.，同義名 Scandix bulbosa Roth 及 Myrrhis bulbosa Sprengel。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
