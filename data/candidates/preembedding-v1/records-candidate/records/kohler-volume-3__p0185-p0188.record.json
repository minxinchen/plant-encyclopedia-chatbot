    {
      "section_id": "kohler-volume-3:p0185-p0188:s02:x00",
      "section_type": "flowering",
      "original_text": "            Blütezeit.           Juni, Juli; Fruchtreife im September und Oktober.",
      "normalized_text": null,
      "zh_tw_rendering": "花期六月至七月，果熟期九月至十月。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
