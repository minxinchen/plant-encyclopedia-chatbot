        "source_line_start": 16,
        "source_line_end": 25,
        "section_index": 1,
        "section_type": "description"
      },
      "exact_text_sha256": "521ceaac0d9a346037479d7499d150058df1c14b287be2f5e3f4d55da10f6336",
