      "section_id": "kohler-volume-2:p0353-p0356:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                                       Gossypium barbadense L. —\n                                            Baumwolle 一 Cotonnier — Cotton.\n             Familie: Malvaceae (Unterfamilie: Hibisceae); Gattung: Gossypium L.",
      "normalized_text": null,
      "zh_tw_rendering": "錦葵科木棉屬，學名 Gossypium barbadense L.，俗稱棉花。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
        "source_id": "kohler-volume-2",
        "volume": 2,
        "pdf_page": 353,
        "source_pdf_sha256": "ebb0cd9d1341855185783b99cbbb5f112134283d84bc1940c97040009e6cc5bf",
