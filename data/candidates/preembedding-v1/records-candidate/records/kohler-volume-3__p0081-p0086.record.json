    {
      "section_id": "kohler-volume-3:p0081-p0086:s05:x00",
      "section_type": "constituents",
      "original_text": "        Bestandteile. Haake (Amer. Journ. Pharm. 1891. p. 383) fand in den Blüten der\nPflanze einen glukosidischen Bitterstoff, Baldriansäure, ein Hüchtiges Alkaloid und ätherisches\nÖl.   Nähere       Angaben      fehlen.",
      "normalized_text": null,
      "zh_tw_rendering": "成分：花朵含糖苷苦味質、異戊酸、揮發性生物鹼及精油。",
      "evidence_indexes": [
        1
      ],
