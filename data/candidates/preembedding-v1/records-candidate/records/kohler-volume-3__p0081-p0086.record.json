      "section_type": "flowering",
      "original_text": "          Blütezeit.          Juni bis Oktober.",
      "normalized_text": null,
      "zh_tw_rendering": "花期為六月至十月。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 82,
