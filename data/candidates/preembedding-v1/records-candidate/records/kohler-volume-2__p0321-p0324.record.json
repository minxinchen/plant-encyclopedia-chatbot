        "source_line_start": 27,
        "source_line_end": 34,
        "section_index": 2,
        "section_type": "anatomy"
      },
      "exact_text_sha256": "b91867f4eac2460a58b1dfbf65cffc70d47c04ad04edfab2b5d8c46d446d1b37",
      "review_status": "machine_extracted_candidate"
