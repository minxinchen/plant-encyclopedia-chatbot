    {
      "section_id": "kohler-volume-2:p0321-p0324:s03:x00",
      "section_type": "distribution",
      "original_text": "         Vorkommen.        Von Surinam bis Panama, auf den Antillen und im nördlichen Brasilien ein-\nheimisch. In Brasilien und Westindien kultivirt.                                                    |",
      "normalized_text": null,
      "zh_tw_rendering": "原產於蘇里南至巴拿馬、安的列斯群島及北巴西。在巴西及西印度群島有栽培。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-2",
        "volume": 2,
        "pdf_page": 322,
