    },
    {
      "section_id": "kohler-volume-3:p0245-p0248:s02:x00",
      "section_type": "distribution",
      "original_text": "         Vorkommen.    Argentinische Republik, Provinz Santiago, insbesondere im Bezirk von\n Catamarca, wahrscheinlich auch in Chile, Bolivia und Südbrasilien.",
      "normalized_text": null,
      "zh_tw_rendering": "產阿根廷聖地亞哥省，可能分佈於智利、玻利維亞及南巴西。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 246,
