      "exact_text_sha256": "643bcebc0717a3fcdcfac0cdb212b6a11954306ba868fbf65ecc4acad6f98aa3",
      "review_status": "machine_extracted_candidate"
    },
    {
      "section_id": "kohler-volume-2:p0437-p0440:s02:x00",
      "section_type": "distribution",
      "original_text": "             In den Gebirgen der Somaliküste.               Hildebrand       fand den Baum in den Kalkgebirgen                   des\nnördlichen     Somalilandes    in Meereshéhen         von   1000    bis 1800 Meter.       E                   i    ee        E",
      "normalized_text": null,
      "zh_tw_rendering": "產於索馬里海岸山區，海拔1000至1800米，北索馬里石灰岩山脈。",
      "evidence_indexes": [
