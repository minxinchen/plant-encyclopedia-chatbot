      },
      "exact_text_sha256": "e5e32c355235b908de9e05a1b7a0b893314a2cc72991032ebb592429a86d4d6c",
      "review_status": "machine_extracted_candidate"
    },
    {
      "section_id": "kohler-volume-3:p0045-p0048:s02:x00",
      "section_type": "distribution",
      "original_text": "           Vorkommen.              Auf Bangka          wild; kultiviert auf Java, insbesondere im Culturtuin zu\nBuitenzorg       und    Tijkeumeuk.",
      "normalized_text": null,
      "zh_tw_rendering": "野生於邦加島；栽培於爪哇，特別是Buitenzorg和Tijkeumeuk的栽培園。",
      "evidence_indexes": [
        0
