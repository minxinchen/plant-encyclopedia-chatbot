    {
      "section_id": "kohler-volume-1:p0181-p0182:s02:x00",
      "section_type": "distribution",
      "original_text": "         Verbreitung*   Auf Ackerrandern, Triften, Wiesen, in Niederungen bis in die Gebirge durch\nEuropa, Nordasien (bis zum Himalaya herab) und Nordamerika verbreitet.",
      "normalized_text": null,
      "zh_tw_rendering": "分佈於歐洲、北亞（至喜馬拉雅）及北美，生長於田埂、草地及山區。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
