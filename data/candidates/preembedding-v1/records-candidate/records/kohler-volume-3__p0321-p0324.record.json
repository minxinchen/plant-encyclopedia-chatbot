    },
    {
      "section_id": "kohler-volume-3:p0321-p0324:s04:x00",
      "section_type": "constituents",
      "original_text": "                      Die Samen enthalten Gummi, Stärke, Protein, Äpfelsäure, die Alkaloide\nDelphinin, Delphinoidin, Delphisin und Staphisagrin, fettes und etwas ätherisches Öl. Das\nletztere       wurde       in Quantitäten\n                                  von 0,02°/, durch Dampfdestillation 1890 von Haensel er-\nhalten; es bildet eine rotbraune Flüssigkeit von eigentümlichem Geruch nach Carvolsulfhydrat;",
      "normalized_text": null,
      "zh_tw_rendering": "種子含膠質、澱粉、蛋白質、蘋果酸及生物鹼：Delphinin、Delphinoidin、Delphisin與Staphisagrin。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 322,
        "source_pdf_sha256": "e5595cebe80e6e645852e6ee581189f0b179d54d74ef72d0e5c10456a110ed64",
        "char_start": 4203,
        "char_end": 4611,
        "page_text_sha256": "f3daa694c6b063381ff9b9ed38f945aae0ab2f25cbacef506e4ef853fb1a6991",
        "exact_text_sha256": "46684667530648f065f9892a3a0ba39ed18f63e4fa25dc96eabe95344b9880e9",
        "source_line_start": 53,
        "source_line_end": 57,
        "section_index": 4,
        "section_type": "constituents"
      },
      "exact_text_sha256": "46684667530648f065f9892a3a0ba39ed18f63e4fa25dc96eabe95344b9880e9",
