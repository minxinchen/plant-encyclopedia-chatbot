    {
      "section_id": "kohler-volume-3:p0333-p0336:s03:x00",
      "section_type": "distribution",
      "original_text": "              Vorkommen.\n                       Der Baum ist in der wärmeren nördlich gemässigten Zone einheimisch;\ner findet sich im südlichen Europa ebenso wie im gemässigten Asien, Afrika und Nordamerika.\nIn Deutschland               wird     er namentlich\n                                     in den Rheingegenden als Chausseebaum gezogen;                                                                im\nnördlichen Frankreich wird er seiner Früchte wegen angebaut und gepflegt. Ä",
      "normalized_text": null,
      "zh_tw_rendering": "原產於溫暖北溫帶，分佈於南歐、亞洲、非洲及北美。德國萊茵區作行道樹，北法栽培。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 334,
        "source_pdf_sha256": "e5595cebe80e6e645852e6ee581189f0b179d54d74ef72d0e5c10456a110ed64",
        "char_start": 4643,
        "char_end": 5128,
        "page_text_sha256": "e8710f9f1436cb79d7fcc64b9752a0bf830c0cd8351987b34b59031dfe20e390",
        "exact_text_sha256": "9bbebd88d1e6391283e1b31863449c05ac60a2031ee2ae9d66286108b244a09d",
        "source_line_start": 53,
        "source_line_end": 58,
        "section_index": 3,
        "section_type": "distribution"
      },
      "exact_text_sha256": "9bbebd88d1e6391283e1b31863449c05ac60a2031ee2ae9d66286108b244a09d",
