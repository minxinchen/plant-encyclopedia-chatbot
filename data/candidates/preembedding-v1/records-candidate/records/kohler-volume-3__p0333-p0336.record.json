        "char_end": 4641,
        "page_text_sha256": "e8710f9f1436cb79d7fcc64b9752a0bf830c0cd8351987b34b59031dfe20e390",
        "exact_text_sha256": "d07a359c29013ef107a57f7a7de77b7250044c8b684ff9efcd06e8dafba5ec9e",
        "source_line_start": 51,
        "source_line_end": 51,
        "section_index": 2,
        "section_type": "flowering"
      },
      "exact_text_sha256": "d07a359c29013ef107a57f7a7de77b7250044c8b684ff9efcd06e8dafba5ec9e",
