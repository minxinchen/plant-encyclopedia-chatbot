      "section_id": "kohler-volume-3:p0333-p0336:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                                        Castanea vesca Gaertner.\nEchte Kastanie,              essbare     Kastanie,            Edelkastaniee        Engl.: Chestnut.           Franz.: Chätaignier,\n                          Castanier, Marronier                 d’Europe.       Holl.: tamme           Kastanje.\n\n           Syn.: (astanea vulgaris Lam.                       Castanea sativa Mill.         Castanea Castanea Karsten.                  Fagus\nCastanea    UL.\n\n           Familie: Cupuliferae (Fagaceae Engl.)                         Unterfamilie:         Castaneae.       Gattung:             Castanea\nTournef.",
      "normalized_text": null,
      "zh_tw_rendering": "學名 Castanea vesca Gaertner。別名：Castanea vulgaris、Castanea sativa。科：Cupuliferae (Fagaceae)。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
        "source_id": "kohler-volume-3",
        "volume": 3,
        "pdf_page": 333,
        "source_pdf_sha256": "e5595cebe80e6e645852e6ee581189f0b179d54d74ef72d0e5c10456a110ed64",
        "char_start": 0,
        "char_end": 618,
        "page_text_sha256": "9eb75e443996a07c9902f22177f91c9bbd79c71ba45dbd71d0063a315a354c30",
        "exact_text_sha256": "3388947a9ccc23303cd7836b2a4614cadadef8545947f550772659b9161b8100",
        "source_line_start": 1,
        "source_line_end": 9,
        "section_index": 0,
        "section_type": "taxonomy"
      },
      "exact_text_sha256": "3388947a9ccc23303cd7836b2a4614cadadef8545947f550772659b9161b8100",
