    {
      "section_id": "kohler-volume-2:p0117-p0120:s03:x00",
      "section_type": "distribution",
      "original_text": "            Vorkommen.               Auf Wiesen und an Bachufern durch Europa und Nordasien bis Japan.                                          Von\nden spanischen Gebirgen bis zum Nordkap;                        in Griechenland,        Schwarzwald         und Vogesen, Dänemark                und\nEngland fehlend.             Im Süden mehr Gebirgspflanze und bis 2700 Meter emporsteigend, im Norden in\nden Niederungen;           im östlichen Finnmarken               bis 250 Meter Meereshóhe.",
      "normalized_text": null,
      "zh_tw_rendering": "分佈於歐洲至北亞及日本，生長於草地與溪邊，海拔可達 2700 公尺。",
      "evidence_indexes": [
        1
      ],
      "source_locator": {
        "source_id": "kohler-volume-2",
        "volume": 2,
        "pdf_page": 118,
        "source_pdf_sha256": "ebb0cd9d1341855185783b99cbbb5f112134283d84bc1940c97040009e6cc5bf",
