        "exact_text_sha256": "27d30c1e385380bd722400389868782cc78dacdb08f2a7cd9d8c037a913c4e37",
        "source_line_start": 36,
        "source_line_end": 39,
        "section_index": 3,
        "section_type": "distribution"
      },
      "exact_text_sha256": "27d30c1e385380bd722400389868782cc78dacdb08f2a7cd9d8c037a913c4e37",
      "review_status": "machine_extracted_candidate"
