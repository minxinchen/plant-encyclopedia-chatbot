      "section_id": "kohler-volume-2:p0117-p0120:s00:x00",
      "section_type": "taxonomy",
      "original_text": "                                                 Veratrum                 album L.\n         Weisse       Niesswurzel,            weisser Germer         —     Hellebore blanc —          White Hellebore.\n\n               Familie: Liliaceae ( Colchicaceae ). Gattung: Veratrum L.",
      "normalized_text": null,
      "zh_tw_rendering": "學名 Veratrum album L.，百合科。俗名白藜蘆、白胡蘆巴。",
      "evidence_indexes": [
        0
      ],
      "source_locator": {
        "source_id": "kohler-volume-2",
        "volume": 2,
        "pdf_page": 117,
