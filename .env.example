# Optional Gemini Free Tier integration. Never commit a real key.
GEMINI_API_KEY=

# Local-only services. Defaults are loopback and may be overridden.
PLANT_ENCYCLOPEDIA_CHAT_API_URL=http://127.0.0.1:18765
N8N_BASE_URL=http://127.0.0.1:5678
QWEN_BASE_URL=http://127.0.0.1:18080

# Source PDFs stay outside the repository.
KOHLER_SOURCE_ROOT=/Volumes/NO NAME
